# Variáveis de ambiente do GoMech AI Service (lidas por app/core/config.py).
#
# Uso local: copie para .env (cp .env.example .env) e descomente o que quiser sobrescrever.
# As linhas comentadas mostram o valor padrão definido no código.
# O docker-compose da raiz também carrega este arquivo, e uma linha ativa aqui sobrescreve
# o mesmo valor definido no .env da raiz. Por isso os valores configuráveis ficam comentados.
# Nunca versione chaves reais.

# Identificação do serviço
AI_SERVICE_NAME=gomech-ai
# Versão exibida no OpenAPI (/docs).
# AI_SERVICE_VERSION=1.0.0

# Segredo compartilhado com o AI Gateway do backend, enviado em X-GoMech-Service-Auth
# (ou Authorization: Bearer <segredo>). O padrão abaixo serve só para desenvolvimento local;
# em produção, gere um valor forte (por exemplo, openssl rand -hex 32) e use o mesmo no backend.
# SERVICE_AUTH_SECRET=gm-ai-internal-hmac-secret

# Provedor de IA: mock | gemini | openai. Qualquer outro valor cai no mock.
# DEFAULT_PROVIDER=mock

# Google Gemini. Sem chave, o provedor gemini responde com o mock.
# GEMINI_API_KEY=sua-chave-gemini

# OpenAI. O adaptador ainda é um esqueleto e delega ao mock; a chave só liga o caminho de retry.
# OPENAI_API_KEY=sua-chave-openai
# OPENAI_BASE_URL=https://api.openai.com/v1

# Resiliência das chamadas aos provedores externos
# TIMEOUT_SECONDS=15.0
# MAX_RETRIES=3

# Nível de log (DEBUG, INFO, WARNING, ERROR). Os logs saem em JSON no stdout.
# LOG_LEVEL=INFO

# Porta HTTP. Lida pelo comando do Dockerfile, não pelo código; o Cloud Run injeta o valor.
# PORT=8000
